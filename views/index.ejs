<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog App</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/">
          <i class="fas fa-comments me-2"></i>Blog App
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if (user) { %>
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
              >
                <i class="fas fa-user me-1"></i><%= user.firstName %> <%=
                user.lastName %>
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/profile"
                    ><i class="fas fa-user-circle me-2"></i>Profile</a
                  >
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <a class="dropdown-item" href="/logout"
                    ><i class="fas fa-sign-out-alt me-2"></i>Logout</a
                  >
                </li>
              </ul>
            </li>
            <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">
                <i class="fas fa-sign-in-alt me-1"></i>Login
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/signup">
                <i class="fas fa-user-plus me-1"></i>Sign Up
              </a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <% if (user) { %>
          <div class="alert alert-success" role="alert">
            <h4 class="alert-heading">Welcome back, <%= user.firstName %>!</h4>
            <p>You are successfully signed in to the Blog.</p>
            <hr />
            <p class="mb-0">
              Start exploring discussions and share your thoughts!
            </p>
          </div>
          <% } else { %>
          <div class="text-center">
            <h1 class="display-4 mb-4">Welcome to Blog App</h1>
            <p class="lead mb-4">
              Join our community and start meaningful discussions!
            </p>
        <div class="d-grid gap-2 d-md-flex                              justify-content-md-center">
              <a href="/signup" class="btn btn-primary btn-lg me-md-2">
                <i class="fas fa-user-plus me-2"></i>Sign Up
              </a>
              <a href="/login" class="btn btn-outline-primary btn-lg">
                <i class="fas fa-sign-in-alt me-2"></i>Login
              </a>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
